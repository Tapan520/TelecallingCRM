@page
@model TelecallingCRM.Pages.Onboarding.IndexModel
@{
    ViewData["Title"] = "Onboarding";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0"><i class="bi bi-person-check-fill text-primary me-2"></i>Onboarding Checklist</h5>
</div>

@if (User.IsInRole("admin") || User.IsInRole("manager"))
{
    <!-- Admin view: progress of all agents -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Agent Onboarding Progress</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Agent</th><th>Progress</th><th>Completed</th><th>Pending</th><th>Actions</th></tr>
                    </thead>
                    <tbody id="progress-tbody">
                        <tr><td colspan="5" class="text-center text-muted py-4">Loading...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <hr />
    <h6 class="fw-bold mb-3">My Checklist</h6>
}

<!-- Agent's own checklist -->
<div id="my-checklist">
    <div class="text-center text-muted py-4">Loading...</div>
</div>

@section Scripts {
<script>
async function loadProgress() {
    const res = await fetch('/api/onboarding/progress');
    if (!res.ok) return;
    const items = await res.json();
    const tbody = document.getElementById('progress-tbody');
    if (!tbody) return;
    if (!items.length) { tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No agents have onboarding checklists.</td></tr>'; return; }
    tbody.innerHTML = items.map(a => {
        const pct = Math.round((a.completed / a.total) * 100);
        return `<tr>
            <td class="fw-semibold">${a.agentName}</td>
            <td style="min-width:150px;">
                <div class="progress" style="height:8px;">
                    <div class="progress-bar bg-success" style="width:${pct}%"></div>
                </div>
                <small class="text-muted">${pct}%</small>
            </td>
            <td><span class="badge bg-success">${a.completed}</span></td>
            <td><span class="badge bg-warning text-dark">${a.pending}</span></td>
            <td><button class="btn btn-outline-primary btn-sm" onclick="initChecklist('${a.agentId}')">Re-init</button></td>
        </tr>`;
    }).join('');
}

async function loadMyChecklist(agentId) {
    const url = agentId ? `/api/onboarding?agentId=${agentId}` : '/api/onboarding';
    const res = await fetch(url);
    if (!res.ok) return;
    const steps = await res.json();
    const container = document.getElementById('my-checklist');
    if (!steps.length) {
        container.innerHTML = '<div class="alert alert-info">No checklist found. Ask your admin to initialise your onboarding.</div>';
        return;
    }
    const completed = steps.filter(s => s.status === 'Completed').length;
    const pct = Math.round((completed / steps.length) * 100);
    container.innerHTML = `
        <div class="mb-3">
            <div class="d-flex justify-content-between mb-1">
                <span class="fw-semibold">Overall Progress</span>
                <span class="text-muted small">${completed}/${steps.length} completed</span>
            </div>
            <div class="progress" style="height:10px;">
                <div class="progress-bar bg-success" style="width:${pct}%"></div>
            </div>
        </div>
        <div class="list-group">
            ${steps.map(s => `
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center ${s.status === 'Completed' ? 'bg-success' : 'bg-light border'}" style="width:32px;height:32px;">
                        <i class="bi ${s.status === 'Completed' ? 'bi-check-lg text-white' : 'bi-circle text-muted'}"></i>
                    </div>
                    <div>
                        <div class="fw-semibold ${s.status === 'Completed' ? 'text-decoration-line-through text-muted' : ''}">${s.stepName}</div>
                        <div class="text-muted small">${s.description ?? ''}</div>
                    </div>
                </div>
                ${s.status !== 'Completed' ? `<button class="btn btn-success btn-sm" onclick="completeStep('${s.id}')"><i class="bi bi-check-lg"></i> Done</button>` :
                `<small class="text-muted">${new Date(s.completedAt).toLocaleDateString()}</small>`}
            </div>`).join('')}
        </div>`;
}

async function completeStep(id) {
    const res = await fetch(`/api/onboarding/${id}/complete`, { method: 'PUT' });
    if (res.ok) { loadMyChecklist(); loadProgress(); }
    else alert(await res.text());
}

async function initChecklist(agentId) {
    if (!confirm('Initialise onboarding checklist for this agent?')) return;
    const res = await fetch(`/api/onboarding/init/${agentId}`, { method: 'POST' });
    if (res.ok) loadProgress();
    else alert(await res.text());
}

document.addEventListener('DOMContentLoaded', () => { loadMyChecklist(); loadProgress(); });
</script>
}
